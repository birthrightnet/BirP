# Normalize all text files to LF in the repository, CRLF on checkout (Windows)
* text=auto eol=crlf

# Force all files under source/ (including nested directories) to text + CRLF checkout.
# This reduces mass EOL churn in subfolders like source/WINSYS and source/SOLAUDIO.
source/** text eol=crlf

# Treat binary files as binary - no EOL conversion
*.cur binary
*.exe binary
*.dll binary
*.lib binary
*.obj binary
*.res binary
*.bmp binary
*.ico binary
*.cab binary
*.zip binary
*.7z binary
