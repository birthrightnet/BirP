				<Option type="0" />
				<Option compiler="ow" />
				<Compiler>
					<Add option="-d2" />
				</Compiler>
				<Environment>
					<Variable name="DEBUG" value="ON" />
					<Variable name="OS" value="WIN95" />
					<Variable name="PROFILE" value="" />
					<Variable name="RELEASE" value="OFF" />
