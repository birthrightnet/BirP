<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Birthright Preservation Patch" />
		<Option makefile="MAKEFILE" />
		<Option makefile_is_custom="1" />
		<Option pch_mode="2" />
		<Option compiler="ow" />
		<MakeCommands>
			<Build command="$make -f $makefile OS=$(OS) SOUND=$(SOUND) RELEASE=$(RELEASE) DEBUG=$(DEBUG) PROFILE=$(PROFILE) CHARED=$(CHARED) $(CMD)" />
			<CompileFile command="$make -f $makefile $file OS=$(OS) SOUND=$(SOUND) RELEASE=$(RELEASE) DEBUG=$(DEBUG) PROFILE=$(PROFILE) CHARED=$(CHARED)" />
			<Clean command="$make -f $makefile clean OS=$(OS) SOUND=$(SOUND) RELEASE=$(RELEASE) DEBUG=$(DEBUG) PROFILE=$(PROFILE) CHARED=$(CHARED)" />
			<DistClean command="$make -f $makefile distclean$target" />
			<AskRebuildNeeded command="$make -q -f $makefile $target" />
			<SilentBuild command="$make -f $makefile OS=$(OS) SOUND=$(SOUND) RELEASE=$(RELEASE) DEBUG=$(DEBUG) PROFILE=$(PROFILE) CHARED=$(CHARED) &gt; $(CMD_NULL)" />
		</MakeCommands>
		<Build>
			<Target title="Debug WIN95">
				<Option output="../build-artifacts/binaries/Debug/Windows/nova95" prefix_auto="1" extension_auto="1" />
